DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
JWT_SECRET=
APP_KEY=
APP_SECRET=
PORT=3000
SUPABASE_URL=https://your-project.supabase.co
STORAGE_BUCKET_PUBLIC=true
# Only required for private buckets; never expose this key in mobile.
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=http://localhost:8081,http://localhost:8082
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=Lapse <your-gmail-address@gmail.com>
SMTP_USER=
SMTP_PASSWORD=
# Port 465 uses implicit TLS; other ports require STARTTLS.
# SMTP_ALLOW_INSECURE=true is exclusively for loopback SMTP tests.
# Public HTTPS API URL serving the existing /auth/reset page (not a custom scheme).
PASSWORD_RESET_URL=https://your-existing-api-host.example/auth/reset
